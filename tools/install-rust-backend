#!/usr/bin/env bash
# Install detrytus' optional Rust core (the detrytus-rs package) at the
# commit uv.lock pins detrytus to, so both come from the same source.
# Needs a Rust toolchain. Run it again after `uv sync`, which removes it.
set -euo pipefail
cd "$(dirname "$0")/.."
sha=$(grep -o 'sgaduuw/detrytus?branch=main#[0-9a-f]*' uv.lock | head -1 | cut -d'#' -f2)
if [ -z "$sha" ]; then
    echo "no detrytus commit found in uv.lock" >&2
    exit 1
fi
uv pip install "detrytus-rs @ git+https://github.com/sgaduuw/detrytus@${sha}#subdirectory=rust/py"
