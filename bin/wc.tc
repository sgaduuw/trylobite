// wc [FILE]...: count the lines, words and code points of each file, or
// of standard input when none is named, and say them on standard output,
// as Unix's wc does: a line per file, ending with its name, and a total
// when there are two or more. Exit with 0, or with 1 if a file cannot be
// opened (said on standard error) or output fails. A filter too, for the
// end of a pipe: ls | wc.

import "../include/layout.s";
import "../lib/start.s";
import "../lib/io.tc";

const int WC_MAX = 243;                // trytes read at a time

int status;                            // 1 once anything failed
int lines;                             // what count found
int words;
int points;
tryte buf[WC_MAX];

// Count what descriptor fd reads until its end.
void count(int fd) {
    lines = 0;
    words = 0;
    points = 0;
    bool inside = false;               // inside a word
    int n;
    while ((n = read(fd, buf, WC_MAX)) > 0) {
        points += n;
        for (int i = 0; i < n; i++) {
            tryte c = buf[i];
            if (c == '\n') lines++;
            if (c <= ' ') {            // a space, or a control character
                inside = false;        // such as a newline or tab, ends a word
            } else if (!inside) {
                inside = true;
                words++;
            }
        }
    }
}

void out(tryte *text, int n) {
    if (!put(STDOUT, text, n)) status = 1;
}

// Say l, w and c, and name unless it is 0, on a line of standard output.
void say(int l, int w, int c, tryte *name) {
    tryte line[40];
    int n = decimal(l, line);
    line[n++] = ' ';
    n += decimal(w, line + n);
    line[n++] = ' ';
    n += decimal(c, line + n);
    if (name == 0) {
        line[n++] = '\n';
        out(line, n);
        return;
    }
    line[n++] = ' ';
    out(line, n);
    out(name, length(name));
    out("\n", 1);
}

int main(int argc, tryte **argv) {
    if (argc < 2) {
        count(STDIN);
        say(lines, words, points, 0);
        return status;
    }
    int tl = 0;
    int tw = 0;
    int tc = 0;
    for (int i = 1; i < argc; i++) {
        int fd = open(argv[i]);
        if (fd < 0) {
            puts(STDERR, "wc: ");
            puts(STDERR, argv[i]);
            puts(STDERR, ": cannot open\n");
            status = 1;
            continue;
        }
        count(fd);
        close(fd);
        tl += lines;
        tw += words;
        tc += points;
        say(lines, words, points, argv[i]);
    }
    if (argc > 2) say(tl, tw, tc, "total");
    return status;
}
