// nc HOST PORT: open a TCP connection to port PORT at HOST (an address
// a.b.c.d, or a name to resolve), send it everything standard input
// gives, then print what comes back until the other end closes. nc -l
// PORT: wait for one connection to port PORT and print what it sends
// until it closes. One direction at a time, as there is no waiting on two descriptors at
// once: a peer that answers before it has read everything may wait for
// nc as nc waits for it.
//
// nc -u HOST PORT: send what standard input gives, each read as one
// UDP datagram, and after each print what comes back within a moment.
// nc -u -l PORT: print what each datagram to port PORT carries, until
// killed (Ctrl-C) or output fails.
//
// As Unix's nc. Exit with 0, 1 if the network fails, and 2 for bad
// arguments or no IP server.

import "../include/layout.s";
import "../lib/start.s";
import "../lib/io.tc";
import "../lib/ip.tc";
import "../lib/dns.tc";

const int WAIT = 200000;         // ticks to wait for what comes back
const int DGRAM = 1478;          // the address and port, and 1,472 octets
const int CHUNK = 1460;          // octets a stream read or write moves

tryte out[DGRAM];                // what to send,
tryte in[DGRAM];                 // and what came

bool same(tryte *a, tryte *b) {
    int i = 0;
    while (a[i] == b[i] && a[i] != 0) i++;
    return a[i] == b[i];
}

// The port s writes, 1 to 65535, or NOT_AN_ADDRESS.
int port_of(tryte *s) {
    int n = 0;
    int i = 0;
    while (s[i] >= '0' && s[i] <= '9' && i < 5) {
        n = n * 10 + (s[i] - '0');
        i++;
    }
    if (i == 0 || s[i] != 0 || n < 1 || n > 65535) return NOT_AN_ADDRESS;
    return n;
}

int usage() {
    puts(STDERR, "usage: nc [-u] HOST PORT, or nc [-u] -l PORT\n");
    return 2;
}

// Say on standard error why the network failed, and give 1.
int failed(int why) {
    puts(STDERR, "nc: ");
    if (why == E_NOROUTE) puts(STDERR, "no route there\n");
    else if (why == E_TIMEDOUT) puts(STDERR, "no answer\n");
    else if (why == E_IO) puts(STDERR, "the network is down\n");
    else if (why == E_BUSY) puts(STDERR, "the port is taken\n");
    else if (why == E_REFUSED) puts(STDERR, "connection refused\n");
    else if (why == E_RESET) puts(STDERR, "connection reset\n");
    else puts(STDERR, "failed\n");
    return 1;
}

int listen(int ip, int port) {
    int bound = sys(SYS_CALL, ip, IP_BIND, port);
    if (bound < 0) return failed(bound);
    while (true) {
        int n = sys(SYS_CALL, ip, IP_RECEIVE, in, DGRAM, 0);
        if (n < 0) return failed(n);
        if (!put(STDOUT, in + 6, n - 6)) return 0;
    }
    return 0;
}

int talk(int ip, int to, int port) {
    int bound = sys(SYS_CALL, ip, IP_BIND, 0);
    if (bound < 0) return failed(bound);
    int shift = 16777216;
    for (int i = 0; i < 4; i++) {
        out[i] = to / shift % 256;
        shift = shift / 256;
    }
    out[4] = port / 256;
    out[5] = port % 256;
    while (true) {
        int n = read(STDIN, out + 6, DGRAM - 6);
        if (n == 0) return 0;
        if (n < 0) return 1;
        int sent = sys(SYS_CALL, ip, IP_SEND, out, n + 6);
        if (sent < 0) return failed(sent);
        int got = sys(SYS_CALL, ip, IP_RECEIVE, in, DGRAM, WAIT);
        if (got >= 6) put(STDOUT, in + 6, got - 6);
    }
    return 0;
}

// Copy what descriptor from gives to standard output until its end: 0,
// or 1 if the connection failed.
int drain(int from) {
    while (true) {
        int n = read(from, in, CHUNK);
        if (n == 0) return 0;
        if (n < 0) return failed(n);
        if (!put(STDOUT, in, n)) return 0;
    }
    return 0;
}

int accept_one(int ip, int port) {
    int listening = sys(SYS_CALL, ip, IP_LISTEN, port);
    if (listening < 0) return failed(listening);
    int fd = sys(SYS_CALL, ip, IP_ACCEPT);
    if (fd < 0) return failed(fd);
    sys(SYS_CALL, ip, IP_LISTEN, 0);
    int status = drain(fd);
    close(fd);
    return status;
}

int connect(int ip, int to, int port) {
    int fd = sys(SYS_CALL, ip, IP_CONNECT, to, port);
    if (fd < 0) return failed(fd);
    while (true) {
        int n = read(STDIN, out, CHUNK);
        if (n < 0) return 1;
        if (n == 0) break;
        int sent = sys(SYS_WRITE, fd, out, n);
        if (sent < 0) return failed(sent);
    }
    sys(SYS_IOCALL, fd, IO_SHUTDOWN);
    int status = drain(fd);
    close(fd);
    return status;
}

int main(int argc, tryte **argv) {
    int a = 1;
    bool udp = argc > 1 && same(argv[1], "-u");
    if (udp) a++;
    if (argc != a + 2) return usage();
    bool listening = same(argv[a], "-l");
    int port = port_of(argv[a + 1]);
    if (port == NOT_AN_ADDRESS) return usage();
    int ip = ip_server();
    if (ip < 0) {
        puts(STDERR, "nc: no IP server\n");
        return 2;
    }
    int to = 0;
    if (!listening) to = host_address(ip, argv[a]);
    if (to < 0) {
        unresolved(STDERR, "nc", argv[a], to);
        return 1;
    }
    if (udp && listening) return listen(ip, port);
    if (udp) return talk(ip, to, port);
    if (listening) return accept_one(ip, port);
    return connect(ip, to, port);
}
