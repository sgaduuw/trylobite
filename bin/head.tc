// head [-n N] [FILE]...: say the first N lines (10 unless given) of each
// file, or of standard input when none is named, on standard output, as
// Unix's head does: with two files or more, each starts with a line
// "==> NAME <==", and a blank line comes between them. Exit with 0, or
// with 1 if a file cannot be opened (said on standard error), N is not
// a number, or output fails. A filter too: ls bin | head -n 3.

import "../include/layout.s";
import "../lib/start.s";
import "../lib/io.tc";

const int HD_MAX = 243;                // trytes read at a time
const int HD_LINES = 10;               // lines said when -n is not given
const int NOT_A_NUMBER = -1;           // what number gives for anything else

int lines;                             // lines to say of each
int status;                            // 1 once anything failed
tryte buf[HD_MAX];

void out(tryte *s, int n) {
    if (!put(STDOUT, s, n)) status = 1;
}

// Copy what descriptor fd reads to standard output, up to the end of
// its lines'th line or its end.
void copy(int fd) {
    int left = lines;                  // lines still to say
    int n;
    while (left > 0 && (n = read(fd, buf, HD_MAX)) > 0) {
        int i = 0;
        while (i < n && left > 0) {
            if (buf[i++] == '\n') left--;
        }
        out(buf, i);
    }
}

// The decimal number s spells, at least one digit, or NOT_A_NUMBER.
int number(tryte *s) {
    if (s[0] == 0) return NOT_A_NUMBER;
    int n = 0;
    for (; *s != 0; s++) {
        if (*s < '0' || *s > '9') return NOT_A_NUMBER;
        n = n * 10 + (*s - '0');
    }
    return n;
}

int usage() {
    puts(STDERR, "usage: head [-n N] [FILE]...\n");
    return 1;
}

int main(int argc, tryte **argv) {
    int i = 1;
    lines = HD_LINES;
    if (i < argc && argv[i][0] == '-') {
        tryte *flag = argv[i];
        if (flag[1] != 'n' || flag[2] != 0 || i + 1 >= argc) return usage();
        lines = number(argv[i + 1]);
        if (lines < 0) return usage();
        i += 2;
    }
    if (i == argc) {
        copy(STDIN);
        return status;
    }
    bool named = argc - i > 1;         // two files or more
    bool said = false;                 // a file has been said
    for (; i < argc; i++) {
        int fd = open(argv[i]);
        if (fd < 0) {
            puts(STDERR, "head: ");
            puts(STDERR, argv[i]);
            puts(STDERR, ": cannot open\n");
            status = 1;
            continue;
        }
        if (named) {
            if (said) out("\n", 1);    // a blank line between files
            said = true;
            out("==> ", 4);
            out(argv[i], length(argv[i]));
            out(" <==\n", 5);
        }
        copy(fd);
        close(fd);
    }
    return status;
}
