// ifconfig [ADDRESS/PREFIX [GATEWAY]]: say the IP server's address, the
// length of its network prefix, its gateway and the name server that
// resolvers ask, as
//
//   inet 10.0.0.2/24 gateway 10.0.0.1 nameserver 10.0.0.3
//
// or set the first three: the gateway stays as it was if none is given,
// and 0.0.0.0 means none. ifconfig nameserver ADDRESS sets the name
// server, 0.0.0.0 for none. Exit with 0, 1 if the server refuses, and 2
// for bad arguments or no IP server.

import "../include/layout.s";
import "../lib/start.s";
import "../lib/io.tc";
import "../lib/ip.tc";

tryte line[80];
int at;

void say(tryte *s) {
    for (int i = 0; s[i] != 0; i++) line[at++] = s[i];
}

bool same(tryte *a, tryte *b) {
    int i = 0;
    while (a[i] == b[i] && a[i] != 0) i++;
    return a[i] == b[i];
}

// The prefix length s writes, 0 to 32, or NOT_AN_ADDRESS.
int prefix(tryte *s) {
    int n = 0;
    int i = 0;
    while (s[i] >= '0' && s[i] <= '9' && i < 2) {
        n = n * 10 + (s[i] - '0');
        i++;
    }
    if (i == 0 || s[i] != 0 || n > 32) return NOT_AN_ADDRESS;
    return n;
}

int usage() {
    puts(STDERR, "usage: ifconfig [ADDRESS/PREFIX [GATEWAY]], ");
    puts(STDERR, "or ifconfig nameserver ADDRESS\n");
    return 2;
}

int main(int argc, tryte **argv) {
    if (argc > 3) return usage();
    int ip = ip_server();
    if (ip < 0) {
        puts(STDERR, "ifconfig: no IP server\n");
        return 2;
    }
    if (argc == 3 && same(argv[1], "nameserver")) {
        int server = address(argv[2]);
        if (server == NOT_AN_ADDRESS) return usage();
        if (sys(SYS_CALL, ip, IP_NAMESERVER, server) < 0) {
            puts(STDERR, "ifconfig: the IP server refused\n");
            return 1;
        }
        return 0;
    }
    int now[3];                  // address, prefix length, gateway
    if (ip_query(ip, now) < 0) {
        puts(STDERR, "ifconfig: the IP server failed\n");
        return 1;
    }
    if (argc == 1) {
        say("inet ");
        at += put_address(now[0], line + at);
        line[at++] = '/';
        at += decimal(now[1], line + at);
        say(" gateway ");
        if (now[2] == 0) say("none");
        else at += put_address(now[2], line + at);
        say(" nameserver ");
        int server = sys(SYS_CALL, ip, IP_NAMESERVER, NS_KEEP);
        if (server <= 0) say("none");
        else at += put_address(server, line + at);
        say("\n");
        put(STDOUT, line, at);
        return 0;
    }
    int used;
    int to = address_at(argv[1], &used);
    if (to == NOT_AN_ADDRESS || argv[1][used] != '/') return usage();
    int bits = prefix(argv[1] + used + 1);
    if (bits == NOT_AN_ADDRESS) return usage();
    int gateway = now[2];
    if (argc == 3) gateway = address(argv[2]);
    if (gateway == NOT_AN_ADDRESS) return usage();
    if (sys(SYS_CALL, ip, IP_CONFIG, to, bits, gateway) < 0) {
        puts(STDERR, "ifconfig: the IP server refused\n");
        return 1;
    }
    return 0;
}
